msgstr "Liquid trader"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_E3AC87C512D6"
msgid "清仓：工业品降价"
msgstr "Clearance: industrial prices down"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_8ADD53ACD114"
msgid "清楚的需求"
msgstr "Clear requirements"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_A164432E5B8A"
msgid "温和、敏锐、保持距离"
msgstr "Gentle, perceptive and distant"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_9A0978CADA18"
msgid "灰雀"
msgstr "Greyfinch"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_3832B08D02C6"
msgid "点名追问厨房"
msgstr "Demanding a kitchen's name"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_213B48F0F738"
msgid "热情健谈"
msgstr "Warm and talkative"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_7B03B9C65A70"
msgid "熟悉偏远厨房与小型补给点，经营不常出现在大宗货单上的食物批次。习惯挑安静的频道联络。"
msgstr "Knows remote kitchens and small supply points, carrying food batches rarely seen in bulk cargo lists. Prefers quiet channels."

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_3A8B49E554FE"
msgid "熟悉矿区与拆解场的金属验货，靠一艘小货船往返偏远补给站。很少提起固定的母港。"
msgstr "Knows metal inspection at mines and salvage yards; runs a small ship between remote supply stations. Rarely mentions a home port."

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_1EAFDB69F655"
msgid "熟食收购加价3%"
msgstr "Cooked food purchase premium +3%"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_977C5DE8E30A"
msgid "爱用航线见闻举例，称呼客人为朋友"
msgstr "Uses route stories as examples and calls customers friends"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_5362B7DB09FB"
msgid "爽快的决定"
msgstr "Prompt decisions"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_81A8777C307B"
msgid "物品必须按整件交易。"
msgstr "Items must be traded in whole units."

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_BE8245CF10F9"
msgid "物尽其用"
msgstr "Making full use of things"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_686C2F4CC220"
msgid "用指节轻敲账本封面"
msgstr "Taps the ledger cover with a knuckle"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_DC46311BEEF5"
msgid "短句，先说事实再说条件"
msgstr "Short sentences; facts first, then conditions"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_176247C0649D"
msgid "矿物"
msgstr "Minerals"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_C6FE8AE92EEF"
msgid "矿物商"
msgstr "Mineral trader"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_39248F1A42C6"
msgid "确认成交"
msgstr "Confirm trade"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_E2935B4C9B8A"
msgid "礼貌称呼，措辞准确，避免夸张"
msgstr "Polite forms of address, precise wording and no exaggeration"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_5E20FC223736"
msgid "种子"
msgstr "Seeds"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_B4C0F24EE475"
msgid "种子商"
msgstr "Seed trader"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_D670A6E2568C"
