msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_584EAEFAAE6E"
msgid "液体"
msgstr "Liquid"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_44732D8DA19E"
