msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_AAC6E4A3A642"
msgid "有什么值得留意的报价？"
msgstr "Any quotes worth looking at?"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_9DDDF8E3FDE1"
