msgstr "Another topic"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_6FD9995A7B4F"
msgid "接受这次合作报价"
msgstr "Accept this visit's cooperation price"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_068D730B76D4"
