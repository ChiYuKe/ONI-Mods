msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_A47F09D28DE2"
msgid "商品的游戏预制体未找到，无法交付。"
msgstr "This item's game prefab was not found; delivery is unavailable."

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_84D328FBC8EA"
msgid "商量一下报价"
msgstr "Negotiate the price"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_BDAF8E8D597C"
msgid "喜欢反问，表达直接，不绕弯子"
msgstr "Likes asking questions; speaks plainly and directly"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_F43A63ACA3B4"
msgid "喜欢给停靠站起外号"
msgstr "Likes giving nicknames to ports"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_B50453F5A9B9"
msgid "喜欢：{0}\n不喜欢：{1}\n交往约定：{2}"
msgstr "Likes: {0}\nDislikes: {1}\nBoundaries: {2}"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_144F21680B93"
msgid "圆滑、务实、爱惜物件"
msgstr "Smooth-talking, practical and careful with possessions"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_C2AFF06ED028"
msgid "增产：矿物降价"
msgstr "Increased output: mineral prices down"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_84D2E8B7A88F"
msgid "大宗采购 · 库存充足"
msgstr "Bulk purchasing · Ample stock"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_FFDEE4269A62"
msgid "夸大货物成色"
msgstr "Exaggerating cargo quality"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_2D3FD4069A35"
msgid "她把货箱转了半圈，磨掉的印记朝向舱壁。\n“经过几次转手。成色和重量你可以自己验，别的就不用写在单子上了。”"
msgstr "She turns the crate so its scraped markings face the hold.\n“It has changed hands a few times. Inspect the quality and weight yourself; the rest need not go on the invoice.”"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_77C41FBE35EA"
msgid "她用手挡住了箱角。\n“旧标记不影响金属的成色。你还想继续问的话，我们就只照货单交易。”"
msgstr "She covers the crate's corner with her hand.\n“Old markings do not affect metal quality. If you keep asking, we will stick strictly to the cargo list.”"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_BF05F3300826"
msgid "好奇直率"
msgstr "Curious and direct"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_46281B21EAA5"
msgid "妥善存放货物"
msgstr "Proper cargo storage"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_A91EC0306DCF"
msgid "守时交接"
msgstr "Punctual handovers"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_3483068ADBB0"
msgid "安静的交流"
msgstr "Quiet conversations"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_FDD458B3264D"
msgid "完成交易后，记录会出现在这里。"
msgstr "Completed trades will appear here."

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_49726F09C812"
msgid "定位"
