msgstr "Stock, capacity or budget has changed. Check the updated tradeable quantity before confirming."

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_5D39E98256F8"
msgid "建设潮：金属涨价"
msgstr "Construction boom: metal prices up"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_EB48CD0B293D"
msgid "开口前先摆正袖口"
msgstr "Straightens cuffs before speaking"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_A59F5624A181"
