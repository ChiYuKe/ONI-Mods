msgstr "Old Mi"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_FEC1E30FCC62"
msgid "耐心沟通"
msgstr "Patient communication"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_10E05F1551F5"
