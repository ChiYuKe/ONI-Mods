msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_2D533BF10CD6"
msgid "定位仓库"
msgstr "Locate storage"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_024E555A440B"
msgid "寡言务实"
msgstr "Quiet and practical"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_59B3CF59CB4A"
