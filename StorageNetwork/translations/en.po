msgstr "Contradictory claims"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_239CF7FF77F8"
msgid "船停稳了，账还得算稳。来，聊聊。"
msgstr "The ship is steady; now let us steady the accounts. Come, let us talk."

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_C8A11D7DF26E"
msgid "行商"
msgstr "Trader"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_144A327039FE"
msgid "装备"
msgstr "Equipment"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_5598CC53E785"
