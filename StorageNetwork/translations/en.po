msgstr "Trades use actual stock and budgets"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_87AF53A707B2"
msgid "我的网络 {0}\n供货商现货 {1}"
msgstr "My network {0}\nSupplier stock {1}"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_43D7E1DBC1AF"
msgid "找到愿意长期合作的客户"
