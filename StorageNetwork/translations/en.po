msgstr "Trades mixed industrial batches with batch-specific prices; values clearing hold space."

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_CC121CE357DF"
msgid "结束通讯"
msgstr "End comms"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_B08377C801CE"
msgid "给彼此留余地"
msgstr "Leaving each other some room"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_686F18C797B6"
