msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_186CB2120F16"
msgid "尊重隐私"
msgstr "Respecting privacy"

msgctxt "STRINGS.UI.STORAGENETWORK_TRADING.TEXT_81960354F5BE"
msgid "小行星补给站"
